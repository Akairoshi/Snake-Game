<Application x:Class="Snake.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Snake"
             xmlns:xf="clr-namespace:XamlFlair;assembly=XamlFlair.WPF">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Assets/Themes/Light.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="CloseButton" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource GameCanvasBrush}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                        Background="{TemplateBinding Background}"
                        CornerRadius="0,0,15,15">
                                <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#FF7AE688"/>

                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#FF429C4E"/>

                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <xf:AnimationSettings x:Key="SlideFromUp"
                       Kind="FadeFrom, TranslateYFrom"
                       OffsetY="-50"
                       Opacity="0"
                       Duration="1000"/>
            
            <xf:AnimationSettings x:Key="SlideFromDown"
                       Kind="FadeFrom, TranslateYFrom"
                       OffsetY="50"
                       Opacity="0"
                       Duration="1000"
                       Delay="400"/>
            <xf:AnimationSettings x:Key="JumpButtonDown"
                Kind="ScaleXTo,ScaleYTo"
                ScaleX="0.9"
                ScaleY="0.9"
                Duration="100"
                Easing="Cubic"/>

            <xf:AnimationSettings x:Key="JumpButtonUp"
                Kind="ScaleXTo,ScaleYTo"
                ScaleX="1.0"
                ScaleY="1.0"
                Duration="100"
                Easing="Cubic"/>

            <xf:AnimationSettings x:Key="FadeInRect"
                       Kind="FadeFrom"
                       Opacity="0"
                       Duration="500"/>
            
        </ResourceDictionary>
    </Application.Resources>
</Application>