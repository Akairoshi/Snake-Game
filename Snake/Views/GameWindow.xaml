<Window x:Class="Snake.Views.GameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Snake.Views"
        mc:Ignorable="d"
        Title="GameWindow" Height="800" Width="800">
    <Grid Background="#FF151515">
        <Canvas Margin="66,32,66,96" Background="#FF2F2F2F"/>
        <TextBlock HorizontalAlignment="Center" Margin="0,710,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Foreground="White" FontSize="36" Text="{Binding ScoreView, StringFormat='Score: {0}'}"/>

    </Grid>
</Window>
