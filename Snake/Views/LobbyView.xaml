<Window x:Class="Snake.Views.LobbyView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:xf="clr-namespace:XamlFlair;assembly=XamlFlair.WPF"
        Icon="pack://application:,,,/Assets/Images/Icon.png"
        mc:Ignorable="d"
        xmlns:local="clr-namespace:Snake.Views"
        Title="Snake - Lobby" Height="627" Width="843" Background="{DynamicResource BackgroundBrush}" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" WindowStyle="None">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <StackPanel xf:Animations.Primary="{StaticResource SlideFromDown}" Grid.Column="1" Margin="10,3,15,15" Grid.Row="1">
            <TextBlock TextWrapping="Wrap" Text="Settings" HorizontalAlignment="Center" Foreground="{DynamicResource ForegroundBrush}" FontSize="42" FontFamily="Bahnschrift" FontWeight="Bold"/>
            <Border BorderBrush="{DynamicResource GameCanvasBorder}" BorderThickness="3,3,3,3" Height="105" Background="{DynamicResource GameCanvasBrush}" CornerRadius="10,10,10,10" Margin="0,0,0,15">
                <StackPanel Margin="0,0,0,-2" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock TextWrapping="Wrap" Text="Nickname" Foreground="{DynamicResource ForegroundBrush}" FontSize="30" FontFamily="Bahnschrift" FontWeight="Bold" HorizontalAlignment="Left" Width="152"/>
                    <TextBox TextWrapping="Wrap" Width="338" Height="22" Text="{Binding Nickname, UpdateSourceTrigger=PropertyChanged}" Background="{DynamicResource GameCanvasBrush}" BorderBrush="{DynamicResource GameCanvasBorder}" FontFamily="Bahnschrift" BorderThickness="3,3,3,3" SelectionBrush="{DynamicResource BackgroundBrush}" FontSize="16" FontWeight="Bold"/>
                </StackPanel>
            </Border>
            <Border BorderBrush="{DynamicResource GameCanvasBorder}" BorderThickness="3,3,3,3" Height="169" Background="{DynamicResource GameCanvasBrush}" CornerRadius="10,10,10,10" HorizontalAlignment="Left" Width="396.5">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Width="331">
                    <TextBlock TextWrapping="Wrap" Text="Grid size" Foreground="{DynamicResource ForegroundBrush}" FontSize="30" FontFamily="Bahnschrift" FontWeight="Bold" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" Width="120" Height="35">
                        <TextBlock.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform/>
                                <SkewTransform/>
                                <RotateTransform Angle="0"/>
                                <TranslateTransform/>
                            </TransformGroup>
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    <StackPanel Width="113" VerticalAlignment="Center" Margin="90,0,0,0" HorizontalAlignment="Right">
                        <RadioButton Command="{Binding SetGridSizeCommand}" CommandParameter="7" Content="7x7" Width="92" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,5,0,0" FontFamily="Bahnschrift" BorderBrush="White" FontSize="24" Background="{DynamicResource BackgroundBrush}"/>
                        <RadioButton Command="{Binding SetGridSizeCommand}" CommandParameter="10" Content="10x10" Width="92" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,5,0,0" FontFamily="Bahnschrift" BorderBrush="White" FontSize="24" Background="{DynamicResource BackgroundBrush}" IsChecked="True"/>
                        <RadioButton Command="{Binding SetGridSizeCommand}" CommandParameter="20" Content="20x20" Width="92" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,5,0,0" FontFamily="Bahnschrift" BorderBrush="White" FontSize="24" Background="{DynamicResource BackgroundBrush}"/>
                        <RadioButton Command="{Binding SetGridSizeCommand}" CommandParameter="30" Content="30x30" Width="92" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,5,0,0" FontFamily="Bahnschrift" BorderBrush="White" FontSize="24" Background="{DynamicResource BackgroundBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border BorderBrush="{DynamicResource GameCanvasBorder}" BorderThickness="3,3,3,3" Height="109" Background="{DynamicResource GameCanvasBrush}" Margin="0,15,0,0" CornerRadius="10,10,10,10">
                <StackPanel  Margin="0,0,0,-2" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock TextWrapping="Wrap" Text="Speed" Foreground="{DynamicResource ForegroundBrush}" FontSize="30" FontFamily="Bahnschrift" FontWeight="Bold"/>
                        <TextBlock TextWrapping="Wrap" Text="{Binding SpeedText}" Foreground="{DynamicResource ForegroundBrush}" FontSize="30" FontFamily="Bahnschrift" FontWeight="Bold" HorizontalAlignment="Right" Margin="200,0,0,0"/>
                    </StackPanel>
                    <Slider Value="{Binding Speed}" IsDirectionReversed="True" TickPlacement="BottomRight" Width="347" BorderBrush="{DynamicResource GameCanvasBorder}" Minimum="80" Maximum="220" FontFamily="Bahnschrift" Background="{x:Null}" Foreground="{DynamicResource GameCanvasBorder}"/>
                    <DockPanel Height="27" LastChildFill="False">
                        <TextBlock TextWrapping="Wrap" Text="Slow" Foreground="{DynamicResource ForegroundBrush}" FontSize="18" FontFamily="Bahnschrift" VerticalAlignment="Bottom"/>
                        <TextBlock DockPanel.Dock="Right" TextWrapping="Wrap" Text="Fast" Foreground="{DynamicResource ForegroundBrush}" FontSize="18" FontFamily="Bahnschrift" VerticalAlignment="Bottom"/>
                    </DockPanel>
                </StackPanel>
            </Border>
            <Button xf:Animations.Primary="{xf:Animate BasedOn={StaticResource JumpButtonDown}, Event=MouseEnter}"
        xf:Animations.Secondary="{xf:Animate BasedOn={StaticResource JumpButtonUp}, Event=MouseLeave}" Command="{Binding StartGameCommand}" IsEnabled="{Binding IsStartEnabled}" Content="Start Game" Height="73" BorderBrush="{DynamicResource GameCanvasBorder}" Background="{DynamicResource GameCanvasBrush}" Foreground="{DynamicResource FoodBrush}" FontFamily="Bahnschrift" FontWeight="Bold" FontSize="36" BorderThickness="3,3,3,3" Margin="0,20,0,0"/>
        </StackPanel>
        <StackPanel xf:Animations.Primary="{StaticResource SlideFromDown}" Margin="5,3,10,15" Grid.Row="1">
            <TextBlock TextWrapping="Wrap" Text="Lobby" Foreground="{DynamicResource ForegroundBrush}" FontSize="42" HorizontalAlignment="Center" FontFamily="Bahnschrift" FontWeight="Bold" VerticalAlignment="Center"/>
            <Border BorderBrush="{DynamicResource GameCanvasBorder}" BorderThickness="3,3,3,3" Height="509" Width="348" Background="{DynamicResource GameCanvasBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" CornerRadius="10,10,10,10">
                <StackPanel>
                    <ListBox
                         ItemsSource="{Binding Records}"
                         xf:Animations.Items="{xf:Animate BasedOn={StaticResource FadeInRect}, Event=Visibility}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         BorderThickness="5,5,5,5"
                         Background="{x:Null}"
                         BorderBrush="{x:Null}"
                         Foreground="{DynamicResource ForegroundBrush}" Height="500" Width="342">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="100" Width="303" ScrollViewer.VerticalScrollBarVisibility="Disabled" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="49*"/>
                                        <ColumnDefinition Width="52*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="23*"/>
                                        <RowDefinition Height="27*"/>
                                    </Grid.RowDefinitions>
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                        <TextBlock Text="{Binding Nickname}" TextWrapping="Wrap" Height="26" Width="127" FontFamily="Bahnschrift" FontSize="24" FontWeight="Bold"/>
                                    </ScrollViewer>
                                    <StackPanel Grid.Row="1">
                                        <TextBlock Text="{Binding Speed, StringFormat={}Speed: {0}}" TextWrapping="Wrap" Height="26" Width="127" FontFamily="Bahnschrift" FontSize="16" HorizontalAlignment="Left"/>
                                        <TextBlock Text="{Binding GridSize, StringFormat={}Grid: {0}x{0}}" TextWrapping="Wrap" Height="26" Width="127" FontFamily="Bahnschrift" FontSize="16" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Score, StringFormat={}Score: {0}}" 
                                            FontFamily="Bahnschrift" FontSize="16"/>
                                        <TextBlock Text="{Binding Date, StringFormat={}{0:dd.MM} | {0:HH:mm}}" 
                                            FontFamily="Bahnschrift" FontSize="16"/>
                                        <Button Content="remove" xf:Animations.Primary="{xf:Animate BasedOn={StaticResource JumpButtonDown}, Event=MouseEnter}"
        xf:Animations.Secondary="{xf:Animate BasedOn={StaticResource JumpButtonUp}, Event=MouseLeave}" Command="{Binding DataContext.ItemRemoveCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding Id}" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource GameCanvasBorder}" Foreground="{DynamicResource FoodBrush}" FontFamily="Bahnschrift"/>
                                    </StackPanel>
                                </Grid>

                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>
        </StackPanel>
        <Border xf:Animations.Primary="{StaticResource SlideFromUp}" BorderBrush="Black" Grid.ColumnSpan="2" Background="{DynamicResource GameCanvasBorder}" CornerRadius="0,0,15,15" HorizontalAlignment="Left" VerticalAlignment="Center" Height="47" Width="843">
            <DockPanel LastChildFill="False">
                <Border Width="39" Height="40" Background="{DynamicResource BackgroundBrush}" CornerRadius="0,0,15,15" Margin="10,0,0,0" Padding="2,2,2,2" VerticalAlignment="Top">
                    <Image Source="pack://application:,,,/Assets/Images/AppleWithSnake.png"/>
                </Border>
                <TextBlock x:Name="Window_Title" TextWrapping="Wrap" Margin="20,10,0,10" FontFamily="Bahnschrift" FontSize="24" FontWeight="Bold"/>
                <Button Style="{StaticResource CloseButton}" DockPanel.Dock="Right"
                    Height="40" Width="50"
                    Margin="0,0,5,0"
                    Command="{Binding CloseCommand}"
                    Cursor="Hand" Padding="0,0,0,0" BorderThickness="0,0,0,0" VerticalAlignment="Top">
                    <TextBlock FontSize="24" FontFamily="Bahnschrift" FontWeight="Bold" Text="X"
                        Foreground="{DynamicResource ForegroundBrush}"/>
                </Button>
            </DockPanel>
        </Border>

    </Grid>
</Window>
