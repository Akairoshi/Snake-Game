<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Snake</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Sounds\1.wav" />
    <None Remove="Sounds\2.wav" />
    <None Remove="Sounds\3.wav" />
    <None Remove="Sounds\death.wav" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Sounds\1.wav" />
    <Resource Include="Sounds\2.wav" />
    <Resource Include="Sounds\3.wav" />
    <Resource Include="Sounds\death.wav" />
  </ItemGroup>

</Project>
